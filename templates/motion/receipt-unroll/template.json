{
  "name": "receipt-unroll",
  "description": "A receipt prints line by line, growing down from a fixed header; every line stays on screen. The total lands in red. Never shows prices.",
  "figures": true,
  "vars": {
    "label": {"type": "text", "required": false, "role": "label"},
    "title": {"type": "text", "required": false, "role": "headline", "note": "one *amber* word"},
    "header": {"type": "text", "required": false, "role": "body", "note": "printed at the top of the paper"},
    "lines": {"type": "items", "required": true, "role": "body", "note": "text lines, or {label, amount}"},
    "total_label": {"type": "text", "required": true, "role": "body"},
    "total": {"type": "number", "required": true, "role": "figure"},
    "unit": {"type": "text", "required": true, "role": "figure"},
    "decimals": {"type": "number", "required": false, "role": "figure"},
    "source": {"type": "text", "required": true, "role": "source"}
  },
  "elements": {
    "label": {"role": "label", "font": "sans", "weight": 600, "size": [26, 28], "tracking": 0.16, "upper": true, "max_lines": 1},
    "title": {"role": "headline", "font": "display", "weight": 500, "size": [56, 72], "max_lines": 2},
    "header": {"role": "body", "font": "mono", "weight": 600, "size": [40, 44], "max_lines": 2, "lh": 1.15, "wide": 1.0},
    "item": {"role": "body", "font": "mono", "weight": 400, "size": [40, 40], "max_lines": 3, "lh": 1.15, "wide": 1.0},
    "amount": {"role": "body", "font": "mono", "weight": 400, "size": [40, 40], "max_lines": 1, "lh": 1.15, "wide": 1.0},
    "total_label": {"role": "body", "font": "mono", "weight": 600, "size": [40, 48], "max_lines": 2, "lh": 1.15, "wide": 1.0},
    "total_amount": {"role": "body", "font": "mono", "weight": 600, "size": [40, 48], "max_lines": 1, "lh": 1.15, "wide": 1.0},
    "source": {"role": "source", "font": "sans", "weight": 400, "size": [24, 26], "opacity": 0.7, "max_lines": 2, "wide": 1.0}
  }
}
