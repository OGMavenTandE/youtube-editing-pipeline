{
  "name": "kinetic",
  "description": "Step words: one line on screen at a time. Exit 7 frames ease-in, 2-frame gap, ease-out entrance.",
  "figures": false,
  "vars": {
    "label": {"type": "text", "required": true, "role": "label"},
    "lines": {"type": "lines", "required": true, "role": "headline"},
    "amber_word": {"type": "text", "required": true, "role": "headline", "note": "the one word in the lines set in amber italic"},
    "subline": {"type": "text", "required": true, "role": "subline"},
    "source": {"type": "text", "required": false, "role": "source"}
  },
  "elements": {
    "label": {"role": "label", "font": "sans", "weight": 600, "size": [26, 28], "tracking": 0.16, "upper": true, "max_lines": 1},
    "line": {"role": "headline", "font": "display", "weight": 500, "size": [64, 92], "max_lines": 3},
    "subline": {"role": "subline", "font": "sans", "weight": 400, "size": [40, 46], "max_lines": 3, "wide": 1.15},
    "source": {"role": "source", "font": "sans", "weight": 400, "size": [24, 26], "opacity": 0.7, "max_lines": 2, "wide": 1.0}
  }
}
